// Multi-tenant schema: every business row belongs to a Company.
// Nothing with history is ever deleted (AGENTS.md: no silent data loss): rows are
// deactivated instead, and relations use onDelete: NoAction, so a stray delete fails
// instead of silently taking timesheets, payroll or audit records with it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & access ----------

model Company {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  slug               String    @unique
  /// ISO 4217, e.g. "UZS"
  currency           String    @default("UZS")
  /// IANA zone used to interpret timesheet dates
  timezone           String    @default("Asia/Tashkent")
  /// Deactivated companies can't be used by their members
  isActive           Boolean   @default(true)
  /// The last month paid for (its 1st day): then a 14-day grace period after that month,
  /// then the company is read-only.
  /// Set at creation, then by each SubscriptionPayment.
  paidThrough        DateTime? @db.Date
  /// Departments are used (AGENTS.md: Departments): every new placement needs one, and
  /// they are shown. Off: hidden, and nothing needs one. Owners and admins switch it.
  departmentsEnabled Boolean   @default(false)
  createdAt          DateTime  @default(now())

  /// Its plan per month (no rows only for companies from before plans: no limits, Payroll only)
  plans             CompanyPlan[]
  payments          SubscriptionPayment[]
  memberships       Membership[]
  sites             Site[]
  teams             Team[]
  workers           Worker[]
  holidays          Holiday[]
  ruleSets          PayrollRuleSet[]
  periods           PayrollPeriod[]
  auditLogs         AuditLog[]
  travelRoutes      TravelRoute[]
  timesheetCodes    TimesheetCode[]
  timesheetSettings TimesheetSettings?
  shifts            Shift[]
  departments       Department[]
}

/// What a company pays for: a limit of active workers (workers with a placement
/// overlapping a month) and the modules it includes. Platform-level, no companyId.
/// An archived plan (isActive false) isn't offered any more but stays where it is used.
model Plan {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  /// In soʻm
  monthlyPrice     Decimal  @db.Decimal(14, 2)
  maxActiveWorkers Int
  timesheetModule  Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  companies CompanyPlan[]
}

/// A company's plan from a month on, until a later row (AGENTS.md: Plans). Each month has
/// exactly one plan: changes always start on the 1st of the next month. A pending change
/// (fromMonth in the future) may be replaced or removed until it starts; started rows are
/// never changed.
model CompanyPlan {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  planId    String   @db.Uuid
  /// The 1st of the month it starts
  fromMonth DateTime @db.Date
  /// null for plans given before this history existed
  setById   String?  @db.Uuid
  setAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: NoAction)
  setBy   User?   @relation(fields: [setById], references: [id], onDelete: NoAction)

  @@unique([companyId, fromMonth])
}

/// A payment the platform admin recorded (paid outside the app). Only ever added; each
/// one sets the company's paidThrough. A free extension (e.g. a trial) has amount 0.
model SubscriptionPayment {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  /// In soʻm
  amount       Decimal  @db.Decimal(14, 2)
  paidOn       DateTime @db.Date
  /// The company's new paid-through month (its 1st day)
  paidThrough  DateTime @db.Date
  note         String?
  recordedById String   @db.Uuid
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  recordedBy User    @relation(fields: [recordedById], references: [id], onDelete: NoAction)

  @@index([companyId, createdAt])
}

/// A person who can log in. Logs in with email or phone (at least one is set,
/// enforced by a CHECK constraint in the migration).
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Lowercase
  email              String?   @unique
  /// E.164, e.g. +998901234567
  phone              String?   @unique
  passwordHash       String
  fullName           String
  /// uz | ru | tr | en
  locale             String    @default("uz")
  isActive           Boolean   @default(true)
  /// Can create and manage companies (the product operator, not a customer role)
  isPlatformAdmin    Boolean   @default(false)
  /// Set for temporary passwords; the user must choose a new one before doing anything else
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  memberships Membership[]
  sessions    Session[]    @relation("SessionUser")
  auditLogs   AuditLog[]   @relation("AuditActor")

  impersonatedIn   Session[]             @relation("SessionImpersonated")
  impersonatorIn   AuditLog[]            @relation("AuditImpersonator")
  recordedPayments SubscriptionPayment[]
  planChanges      CompanyPlan[]

  lockedPeriods        PayrollPeriod[]
  workingDaysOverrides WorkingDaysOverride[]
  payrollRules         PayrollRules[]
  salaries             Salary[]
  monthlyHours         MonthlyHours[]
  payrollSnapshots     PayrollSnapshot[]
  adjustments          Adjustment[]
  adjustmentCancels    AdjustmentCancel[]
  travelAmounts        TravelAmount[]
  createdEntries       TimesheetEntry[]      @relation("EntryCreatedBy")
  updatedEntries       TimesheetEntry[]      @relation("EntryUpdatedBy")
  timesheetSettings    TimesheetSettings[]
  workerShifts         WorkerShift[]
}

/// How a session's token is sent: the browser's httpOnly cookie, or the mobile app's
/// Authorization: Bearer header. A token only works the way it was issued.
enum SessionKind {
  BROWSER
  APP
}

/// Server-side login session. The client holds a random token (cookie or bearer);
/// only its SHA-256 hash is stored here.
model Session {
  id                    String      @id @default(uuid()) @db.Uuid
  tokenHash             String      @unique
  kind                  SessionKind @default(BROWSER)
  /// Name the app gave its device (APP sessions), shown when listing and revoking them
  deviceName            String?
  userId                String      @db.Uuid
  /// Company the user is currently working in (one of their memberships)
  activeCompanyId       String?     @db.Uuid
  ip                    String?
  userAgent             String?
  createdAt             DateTime    @default(now())
  lastSeenAt            DateTime    @default(now())
  expiresAt             DateTime
  /// Set while this session's user, a platform admin, is logged in as someone else.
  /// Requests act as that user until impersonationEndsAt (at most 1 hour, never
  /// extended). Ending it clears these fields and the admin is themselves again.
  impersonatedUserId    String?     @db.Uuid
  /// The impersonated user's company being worked in (their activeCompanyId)
  impersonatedCompanyId String?     @db.Uuid
  impersonationEndsAt   DateTime?

  user             User  @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  impersonatedUser User? @relation("SessionImpersonated", fields: [impersonatedUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Who changed what, when. Never updated or deleted by the app.
model AuditLog {
  id                 String   @id @default(uuid()) @db.Uuid
  /// null for platform-level actions (e.g. creating a company)
  companyId          String?  @db.Uuid
  /// null for actions not done by a logged-in user (e.g. CLI bootstrap)
  actorUserId        String?  @db.Uuid
  /// The platform admin who acted while logged in as actorUserId (impersonation)
  impersonatorUserId String?  @db.Uuid
  /// e.g. "auth.login", "member.create", "company.update"
  action             String
  entityType         String?
  entityId           String?
  /// Changed fields (before/after) or other details. Never contains passwords.
  data               Json     @default("{}")
  ip                 String?
  createdAt          DateTime @default(now())

  company      Company? @relation(fields: [companyId], references: [id], onDelete: NoAction)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: NoAction)
  impersonator User?    @relation("AuditImpersonator", fields: [impersonatorUserId], references: [id], onDelete: NoAction)

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  TIMEKEEPER
  FOREMAN
  /// Works on the sites they are assigned to (MemberSite): manages workers and teams
  /// there and assigns timekeepers and foremen
  PROJECT_MANAGER
}

model Membership {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  role      Role
  /// Deactivated members lose access to this company; their history stays
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  /// null = pending invitation. A company that adds a person who already has an account
  /// (from another company) only invites them; they get access once they accept.
  /// Accounts the company creates itself, and owners set up by the platform, are
  /// accepted at creation.
  acceptedAt   DateTime?
  declinedAt   DateTime?
  /// What the inviting company typed. Until the person accepts, the company sees only
  /// these, never the account's own name or contacts (which may come from another company).
  invitedName  String?
  invitedEmail String?
  invitedPhone String?

  user    User         @relation(fields: [userId], references: [id], onDelete: NoAction)
  company Company      @relation(fields: [companyId], references: [id], onDelete: NoAction)
  sites   MemberSite[]
  teams   MemberTeam[]

  @@id([userId, companyId])
}

/// Sites a PROJECT_MANAGER or TIMEKEEPER works on; they see and act only there.
model MemberSite {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  siteId    String   @db.Uuid
  createdAt DateTime @default(now())

  membership Membership @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: NoAction)
  site       Site       @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: NoAction)

  @@id([userId, companyId, siteId])
  @@index([companyId, siteId])
}

/// Teams a FOREMAN leads; they see and act only for these teams.
model MemberTeam {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  teamId    String   @db.Uuid
  createdAt DateTime @default(now())

  membership Membership @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: NoAction)
  team       Team       @relation(fields: [teamId, companyId], references: [id, companyId], onDelete: NoAction)

  @@id([userId, companyId, teamId])
  @@index([companyId, teamId])
}

// ---------- Organisation ----------

model Site {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  name      String
  code      String?
  address   String?
  isActive  Boolean @default(true)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: NoAction)
  teams       Team[]
  assignments Assignment[]
  members     MemberSite[]
  ruleSets    PayrollRuleSet[]
  entries     TimesheetEntry[]

  @@unique([companyId, name])
  /// Target of composite foreign keys that keep children in the same company
  @@unique([id, companyId])
  @@index([companyId])
}

/// A company's department (AGENTS.md: Departments), e.g. HSE or QA/QC, in a tree of any
/// depth: parentId null is a top-level department. Company-wide, not per site. Owners
/// and admins manage them; one is deactivated, never deleted, once used. Names are unique
/// among siblings, ignoring case (a unique index added by hand in the migration). The API
/// refuses a parent that would make a cycle.
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  parentId  String?  @db.Uuid
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: NoAction)
  parent      Department?  @relation("DepartmentTree", fields: [parentId, companyId], references: [id, companyId], onDelete: NoAction, onUpdate: NoAction)
  children    Department[] @relation("DepartmentTree")
  teams       Team[]
  assignments Assignment[]

  @@unique([id, companyId])
  @@index([companyId])
}

model Team {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @db.Uuid
  siteId       String  @db.Uuid
  name         String
  /// The brigade's department. Its placements take it (Assignment.departmentId), so it is
  /// fixed once one of them has it (team.departmentInUse). null while none is set.
  departmentId String? @db.Uuid
  isActive     Boolean @default(true)

  company                  Company          @relation(fields: [companyId], references: [id], onDelete: NoAction)
  site                     Site             @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: NoAction)
  department               Department?      @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: NoAction, onUpdate: NoAction)
  assignments              Assignment[]     @relation("PlacementTeam")
  /// The same placements, through the foreign key that keeps their department the team's
  teamDepartmentPlacements Assignment[]     @relation("PlacementTeamDepartment")
  entries                  TimesheetEntry[]
  foremen                  MemberTeam[]

  @@unique([siteId, name])
  @@unique([id, companyId])
  /// Target of TimesheetEntry's foreign key, which also checks the team is on the entry's site
  @@unique([id, siteId, companyId])
  /// Target of Assignment's foreign key, which keeps a placement's department the team's
  @@unique([id, departmentId, companyId])
  @@index([companyId])
}

// ---------- People ----------

enum EmploymentType {
  DIRECT
  INDIRECT
}

model Worker {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  /// Uzbek personal ID (14 digits); null for some expats
  pinfl          String?
  lastName       String
  firstName      String
  patronymic     String?
  birthDate      DateTime?      @db.Date
  nationality    String?
  passportSeries String?
  passportNumber String?
  phone          String?
  position       String?
  employmentType EmploymentType @default(DIRECT)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  company          Company                 @relation(fields: [companyId], references: [id], onDelete: NoAction)
  assignments      Assignment[]
  salaries         Salary[]
  payrollSnapshots PayrollSnapshotWorker[]
  adjustments      Adjustment[]
  shifts           WorkerShift[]

  @@unique([companyId, pinfl])
  @@unique([id, companyId])
  @@index([companyId, lastName])
}

/// A company's shift (AGENTS.md: Shifts): a name and its own normal hours per day, which
/// replace the rule set's normal hours on the days a worker is on it. Owners and admins
/// define them. The normal hours are fixed once a worker has had the shift (shift.inUse),
/// since a change would reach months already worked; other hours make a new shift. An
/// inactive shift isn't offered any more but stays where it is used. The hours range is a
/// CHECK constraint in the migration.
model Shift {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  name              String
  normalHoursPerDay Decimal  @db.Decimal(4, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: NoAction)
  workers WorkerShift[]

  @@unique([companyId, name])
  @@unique([id, companyId])
}

/// A worker's shift from a day on, until the worker's next row (AGENTS.md: Shifts). Before
/// the first row, and from a row without a shift, the worker has none: the rule set's
/// normal hours apply. Owners, admins, accountants and timekeepers (their sites) add rows;
/// only owners and admins correct or remove one, audited with old and new values.
model WorkerShift {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  workerId  String   @db.Uuid
  /// null = no shift from this day on
  shiftId   String?  @db.Uuid
  fromDay   DateTime @db.Date
  setById   String   @db.Uuid
  setAt     DateTime @default(now())

  worker Worker @relation(fields: [workerId, companyId], references: [id, companyId], onDelete: NoAction)
  shift  Shift? @relation(fields: [shiftId, companyId], references: [id, companyId], onDelete: NoAction)
  setBy  User   @relation(fields: [setById], references: [id], onDelete: NoAction)

  @@unique([workerId, fromDay])
  @@index([companyId])
  @@index([shiftId])
}

/// A worker's placement on a site (and team) for a span of time. Moving to another
/// site ends one placement and starts the next. The salary is not here: it is in
/// Salary, so people who see placements (timekeepers, foremen) never get it.
/// companyId is the worker's company; the composite foreign keys make the database
/// refuse a worker, site, team or travel route from another company.
model Assignment {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  workerId      String    @db.Uuid
  siteId        String    @db.Uuid
  teamId        String?   @db.Uuid
  /// The placement's department (AGENTS.md: Departments); with a team, always the team's
  /// (composite foreign key). The API requires it for new placements while the company
  /// uses departments; placements from before stay null until it is filled in.
  departmentId  String?   @db.Uuid
  /// Used when travel pay is PER_DAY_WORKED; null = no travel pay
  travelRouteId String?   @db.Uuid
  hiredOn       DateTime  @db.Date
  leftOn        DateTime? @db.Date
  createdAt     DateTime  @default(now())

  worker         Worker           @relation(fields: [workerId, companyId], references: [id, companyId], onDelete: NoAction)
  site           Site             @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: NoAction)
  team           Team?            @relation("PlacementTeam", fields: [teamId, companyId], references: [id, companyId], onDelete: NoAction)
  department     Department?      @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: NoAction, onUpdate: NoAction)
  /// Checked only when the placement has both a team and a department (MATCH SIMPLE)
  teamDepartment Team?            @relation("PlacementTeamDepartment", fields: [teamId, departmentId, companyId], references: [id, departmentId, companyId], onDelete: NoAction, onUpdate: NoAction)
  travelRoute    TravelRoute?     @relation(fields: [travelRouteId, companyId], references: [id, companyId], onDelete: NoAction)
  entries        TimesheetEntry[]
  monthlyHours   MonthlyHours[]
  travelAmounts  TravelAmount[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([siteId, hiredOn])
  @@index([workerId])
  @@index([departmentId])
}

/// A worker's monthly salary from a month on. It belongs to the worker, not to a
/// placement, so moving to another site keeps it. Salaries are only ever added (the
/// accountant never edits): a raise or a correction is a newer row. A month's salary is
/// the row with the latest from-month on or before it, the newest (highest seq) if
/// several share that month. Ranges are CHECK constraints in the migration.
model Salary {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  workerId      String   @db.Uuid
  fromYear      Int
  /// 1-based
  fromMonth     Int
  monthlySalary Decimal  @db.Decimal(14, 2)
  reason        String?
  seq           BigInt   @unique @default(autoincrement())
  setById       String   @db.Uuid
  setAt         DateTime @default(now())

  worker Worker @relation(fields: [workerId, companyId], references: [id, companyId], onDelete: NoAction)
  setBy  User   @relation(fields: [setById], references: [id], onDelete: NoAction)

  @@index([workerId, fromYear, fromMonth])
  @@index([companyId])
}

// ---------- Calendar & rules ----------

/// Holidays an admin enters. Uzbekistan's fixed-date public holidays are shipped in
/// @puantaj/payroll (uzbekistanFixedHolidays) and not stored here.
enum HolidayKind {
  /// Moving public holidays, announced each year. A year without both is incomplete.
  RAMAZON_HAYIT
  QURBON_HAYIT
  /// Extra public day off declared by the government
  PUBLIC_EXTRA
  /// Day off for this company only
  COMPANY_DAY_OFF
  /// Not a day off: a rest weekday that is a working day, the other half of a
  /// government day-off swap
  WORKING_DAY
}

model Holiday {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @db.Uuid
  date      DateTime    @db.Date
  kind      HolidayKind
  /// Optional note, e.g. the day a WORKING_DAY swaps with. The kind names the day.
  name      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)

  @@unique([companyId, date])
}

/// How travel pay is worked out (Settings).
enum TravelPayMode {
  /// The company doesn't pay travel
  NONE
  /// Days worked × the amount per day of the worker's route (Assignment.travelRoute)
  PER_DAY_WORKED
  /// A monthly amount the accountant enters per placement (TravelAmount)
  MONTHLY_AMOUNT
}

/// Where pay rules apply: the company default (siteId = null) or one site, whose
/// rules override the default. The rules themselves are versioned by month
/// (PayrollRules); working-days overrides belong to the rule set.
model PayrollRuleSet {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  siteId    String?  @db.Uuid
  createdAt DateTime @default(now())

  company              Company               @relation(fields: [companyId], references: [id], onDelete: NoAction)
  site                 Site?                 @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: NoAction)
  versions             PayrollRules[]
  workingDaysOverrides WorkingDaysOverride[]

  /// One rule set per site. PostgreSQL treats NULLs as distinct, so "one company default
  /// (siteId = null)" is a partial unique index added by hand in its migration.
  @@unique([companyId, siteId])
  @@unique([id, companyId])
}

/// Pay policy (Settings) of a rule set from a month on: it applies to that month and
/// every later one until the next version, so older months keep the rules they had.
/// Value ranges are CHECK constraints in the migration.
/// The normal-hours multiplier is always 1 and isn't stored: working every working
/// day at normal hours pays exactly the monthly salary.
model PayrollRules {
  id                   String        @id @default(uuid()) @db.Uuid
  companyId            String        @db.Uuid
  ruleSetId            String        @db.Uuid
  fromYear             Int
  /// 1-based
  fromMonth            Int
  /// ISO weekdays that are rest days (7 = Sunday)
  restWeekdays         Int[]
  /// Normal hours on a working day; hours above it are overtime
  normalHoursPerDay    Decimal       @db.Decimal(4, 2)
  /// Multipliers of the other kinds of hour. No defaults: the admin enters them.
  overtimeMultiplier   Decimal       @db.Decimal(4, 2)
  restDayMultiplier    Decimal       @db.Decimal(4, 2)
  holidayMultiplier    Decimal       @db.Decimal(4, 2)
  /// Absence pay per type: paid or not, and hours paid per absence day.
  /// Hours null = the normal hours per day, following it when it changes (the default
  /// for leave and travel/transfer). Absences on rest days and holidays are never paid.
  leavePaid            Boolean
  leaveHoursPerDay     Decimal?      @db.Decimal(4, 2)
  sickPaid             Boolean
  sickHoursPerDay      Decimal?      @db.Decimal(4, 2)
  /// Travel/transfer days (DayStatus TRAVEL), not to be confused with travel pay
  travelDayPaid        Boolean
  travelDayHoursPerDay Decimal?      @db.Decimal(4, 2)
  travelPayMode        TravelPayMode
  /// The amount to pay out is rounded to the nearest multiple of this (halves up).
  /// Company-wide: set only in the company default rule set, null in site rule sets
  /// (AGENTS.md: Pay model). The API is the only writer and keeps it that way.
  payRoundingStep      Decimal?      @db.Decimal(14, 2)
  /// Who saved this version last (owners and admins may replace it). Every change is
  /// also in AuditLog.
  setById              String        @db.Uuid
  setAt                DateTime      @default(now())

  ruleSet PayrollRuleSet @relation(fields: [ruleSetId, companyId], references: [id, companyId], onDelete: NoAction)
  setBy   User           @relation(fields: [setById], references: [id], onDelete: NoAction)

  @@unique([ruleSetId, fromYear, fromMonth])
  @@index([companyId])
}

/// An override of the calculated working days for one month of a rule set. Overrides
/// are never changed: a correction is a newer row, and the newest (highest seq) counts.
/// workingDays null = back to the calculated value. The calculated value isn't stored:
/// it follows from the rules' rest weekdays and the holidays, so the app can always
/// show both side by side.
model WorkingDaysOverride {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  ruleSetId   String   @db.Uuid
  year        Int
  month       Int
  workingDays Int?
  reason      String?
  /// Order the overrides were added in
  seq         BigInt   @unique @default(autoincrement())
  setById     String   @db.Uuid
  setAt       DateTime @default(now())

  ruleSet PayrollRuleSet @relation(fields: [ruleSetId, companyId], references: [id, companyId], onDelete: NoAction)
  setBy   User           @relation(fields: [setById], references: [id], onDelete: NoAction)

  @@index([ruleSetId, year, month])
  @@index([companyId])
}

/// A route workers travel to a site, with its travel pay per day worked.
model TravelRoute {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  name         String
  amountPerDay Decimal  @db.Decimal(14, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: NoAction)
  assignments Assignment[]

  @@unique([companyId, name])
  @@unique([id, companyId])
}

/// A company's own timesheet code (e.g. "IZ" = LEAVE), typed in the daily grid and read by
/// the importer, the same letters in every language (AGENTS.md: The daily grid).
/// code is normalized with normalizeCode() from @puantaj/payroll and never blank: a blank
/// cell means "not employed" outside the worker's employment dates and is a problem inside.
model TimesheetCode {
  companyId String    @db.Uuid
  code      String
  status    DayStatus
  /// The code the grid shows for its status: one per status (partial unique index), and
  /// only for statuses typed in the grid (ABSENT, LEAVE, SICK, TRAVEL; CHECK constraint).
  inGrid    Boolean   @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)

  @@id([companyId, code])
}

// ---------- Timesheets & payroll ----------

enum PeriodStatus {
  OPEN
  LOCKED
}

/// A locked period is final. lockedAt and lockedById are set exactly when it is
/// LOCKED (CHECK constraint in the migration).
model PayrollPeriod {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @db.Uuid
  year       Int
  month      Int
  status     PeriodStatus @default(OPEN)
  lockedAt   DateTime?
  lockedById String?      @db.Uuid

  company   Company           @relation(fields: [companyId], references: [id], onDelete: NoAction)
  lockedBy  User?             @relation(fields: [lockedById], references: [id], onDelete: NoAction)
  entries   TimesheetEntry[]
  snapshots PayrollSnapshot[]

  @@unique([companyId, year, month])
  @@unique([id, companyId])
}

/// What a month paid each time it was locked (AGENTS.md: Data integrity). Never changed
/// or deleted: unlocking keeps it, and locking again adds the next one, so the app can
/// show each lock's differences from the one before. While the month is locked, the
/// latest snapshot is what the app shows.
model PayrollSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  periodId   String   @db.Uuid
  /// 1 for the month's first lock, then 2, 3…
  lockNumber Int
  total      Decimal  @db.Decimal(14, 2)
  lockedById String   @db.Uuid
  lockedAt   DateTime @default(now())

  period   PayrollPeriod           @relation(fields: [periodId, companyId], references: [id, companyId], onDelete: NoAction)
  lockedBy User                    @relation(fields: [lockedById], references: [id], onDelete: NoAction)
  workers  PayrollSnapshotWorker[]

  @@unique([periodId, lockNumber])
  @@unique([id, companyId])
}

/// One worker's pay in a snapshot.
model PayrollSnapshotWorker {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String  @db.Uuid
  snapshotId String  @db.Uuid
  workerId   String  @db.Uuid
  total      Decimal @db.Decimal(14, 2)
  /// The worker's whole result as the payroll page shows it (parts, lines, inputs), so a
  /// locked month keeps showing exactly what was locked.
  detail     Json

  snapshot PayrollSnapshot @relation(fields: [snapshotId, companyId], references: [id, companyId], onDelete: NoAction)
  worker   Worker          @relation(fields: [workerId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([snapshotId, workerId])
  @@index([companyId])
}

/// Mirrors DayStatus in @puantaj/payroll.
enum DayStatus {
  WORKED
  ABSENT
  LEAVE
  SICK
  TRAVEL
  OFF
  NOT_EMPLOYED
}

/// One worker's day at one site/team. A worker who works at several sites or teams on
/// one day has one entry per site/team, with the hours split between them; any other
/// status is the whole day, so it is the day's only entry (checked by @puantaj/payroll
/// and the API, as it spans rows).
/// One entry per assignment, date, site and team: a unique index with NULLS NOT
/// DISTINCT, added by hand in its migration because Prisma can't express it.
/// companyId must match the period's, assignment's, site's and team's (composite foreign keys).
model TimesheetEntry {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  periodId     String    @db.Uuid
  /// The worker's employment (salary, travel route); the hours may be worked at another site
  assignmentId String    @db.Uuid
  /// Where the hours were worked
  siteId       String    @db.Uuid
  /// null = no team. A team must be on siteId (composite foreign key).
  teamId       String?   @db.Uuid
  date         DateTime  @db.Date
  status       DayStatus
  hours        Decimal   @default(0) @db.Decimal(4, 2)
  note         String?
  /// Creation order, never changed by edits: of one worker's entries for a day, the
  /// higher seq was entered later, and gets the day's overtime and travel pay
  /// (DayEntry.seq in @puantaj/payroll). Unlike createdAt it never ties.
  seq          BigInt    @unique @default(autoincrement())
  /// 1 when created, +1 on every change. A write names the version it saw, so stale
  /// data (e.g. from a phone that was offline) is refused instead of overwriting newer.
  version      Int       @default(1)
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedById  String    @db.Uuid
  updatedAt    DateTime  @updatedAt

  period     PayrollPeriod @relation(fields: [periodId, companyId], references: [id, companyId], onDelete: NoAction)
  assignment Assignment    @relation(fields: [assignmentId, companyId], references: [id, companyId], onDelete: NoAction)
  site       Site          @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: NoAction)
  team       Team?         @relation(fields: [teamId, siteId, companyId], references: [id, siteId, companyId], onDelete: NoAction)
  createdBy  User          @relation("EntryCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)
  updatedBy  User          @relation("EntryUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction)

  @@index([assignmentId, date])
  @@index([periodId])
}

/// Who enters daily hours (AGENTS.md: Hour entry). A company without a row has the
/// decided default (DEFAULT_ENTRY_ROLES in @puantaj/schemas: timekeepers). Owners and
/// admins always may, so they aren't listed.
model TimesheetSettings {
  companyId  String   @id @db.Uuid
  /// TIMEKEEPER and/or FOREMAN, never empty (CHECK constraint in the migration)
  entryRoles Role[]
  /// Who saved them last; every change is also in AuditLog
  setById    String   @db.Uuid
  setAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  setBy   User    @relation(fields: [setById], references: [id], onDelete: NoAction)
}

/// One placement's hours for a month entered as totals instead of daily entries
/// (AGENTS.md: Modules), by an owner, admin or accountant. A shift change in the month
/// splits it into parts (AGENTS.md: Shifts), each with its own totals: fromDay and
/// untilDay are the days of the part's shift in the month (the whole month without a
/// change, never cut to the placement). Totals for days that are no longer a part count
/// for nothing. Only ever added: a correction is a newer row, and the newest (highest
/// seq) of a placement, month and days counts. A
/// worker-month has one source of hours, so these and TimesheetEntry rows never both
/// exist for one worker and month (checked by the API). Ranges are CHECK constraints in
/// the migration.
model MonthlyHours {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  assignmentId   String   @db.Uuid
  year           Int
  /// 1-based
  month          Int
  /// First and last day of the part's shift in the month
  fromDay        DateTime @db.Date
  untilDay       DateTime @db.Date
  normalHours    Decimal  @db.Decimal(5, 2)
  overtimeHours  Decimal  @db.Decimal(5, 2)
  restDayHours   Decimal  @db.Decimal(5, 2)
  holidayHours   Decimal  @db.Decimal(5, 2)
  /// Working days with hours worked; travel pay per day worked counts these
  workdaysWorked Int
  leaveDays      Int
  sickDays       Int
  travelDays     Int
  note           String?
  seq            BigInt   @unique @default(autoincrement())
  setById        String   @db.Uuid
  setAt          DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId, companyId], references: [id, companyId], onDelete: NoAction)
  setBy      User       @relation(fields: [setById], references: [id], onDelete: NoAction)

  @@index([assignmentId, year, month])
  @@index([companyId, year, month])
}

enum AdjustmentType {
  /// Added to pay
  BONUS
  /// Money already handed over, taken off pay
  ADVANCE
  /// Taken off pay
  DEDUCTION
}

/// Money added to or taken from a worker's pay for one month (AGENTS.md: Adjustments).
/// It belongs to the worker, not to a placement. The amount is always positive; the
/// type gives the sign. Only ever added: a mistake is cancelled (AdjustmentCancel),
/// never edited or deleted. The amount range is a CHECK constraint in the migration.
model Adjustment {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @db.Uuid
  workerId  String         @db.Uuid
  year      Int
  /// 1-based
  month     Int
  type      AdjustmentType
  amount    Decimal        @db.Decimal(14, 2)
  note      String?
  seq       BigInt         @unique @default(autoincrement())
  setById   String         @db.Uuid
  setAt     DateTime       @default(now())

  worker Worker            @relation(fields: [workerId, companyId], references: [id, companyId], onDelete: NoAction)
  setBy  User              @relation(fields: [setById], references: [id], onDelete: NoAction)
  cancel AdjustmentCancel?

  @@unique([id, companyId])
  @@index([workerId, year, month])
  @@index([companyId, year, month])
}

/// Cancels one adjustment, which then no longer counts but stays visible. Never changed
/// or deleted; an adjustment is cancelled at most once.
model AdjustmentCancel {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  adjustmentId  String   @db.Uuid
  reason        String
  cancelledById String   @db.Uuid
  cancelledAt   DateTime @default(now())

  adjustment  Adjustment @relation(fields: [adjustmentId, companyId], references: [id, companyId], onDelete: NoAction)
  cancelledBy User       @relation(fields: [cancelledById], references: [id], onDelete: NoAction)

  /// One cancel per adjustment (an adjustment id belongs to one company)
  @@unique([adjustmentId, companyId])
  @@index([companyId])
}

/// A placement's monthly travel amount, entered by the accountant when travel pay is
/// MONTHLY_AMOUNT. Only ever added: a correction is a newer row, and the newest (highest
/// seq) of a placement and month counts. The amount range is a CHECK constraint.
model TravelAmount {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  assignmentId String   @db.Uuid
  year         Int
  /// 1-based
  month        Int
  amount       Decimal  @db.Decimal(14, 2)
  note         String?
  seq          BigInt   @unique @default(autoincrement())
  setById      String   @db.Uuid
  setAt        DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId, companyId], references: [id, companyId], onDelete: NoAction)
  setBy      User       @relation(fields: [setById], references: [id], onDelete: NoAction)

  @@index([assignmentId, year, month])
  @@index([companyId, year, month])
}
