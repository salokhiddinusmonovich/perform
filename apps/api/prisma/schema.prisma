// Multi-tenant schema: every business row belongs to a Company.
// Nothing with history is ever deleted (AGENTS.md: no silent data loss): rows are
// deactivated instead, and relations use onDelete: NoAction, so a stray delete fails
// instead of silently taking timesheets, payroll or audit records with it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & access ----------

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  /// ISO 4217, e.g. "UZS"
  currency  String   @default("UZS")
  /// IANA zone used to interpret timesheet dates
  timezone  String   @default("Asia/Tashkent")
  /// Deactivated companies can't be used by their members
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  memberships Membership[]
  sites       Site[]
  teams       Team[]
  workers     Worker[]
  holidays    Holiday[]
  ruleSets    PayrollRuleSet[]
  periods     PayrollPeriod[]
  auditLogs   AuditLog[]
}

/// A person who can log in. Logs in with email or phone (at least one is set,
/// enforced by a CHECK constraint in the migration).
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Lowercase
  email              String?   @unique
  /// E.164, e.g. +998901234567
  phone              String?   @unique
  passwordHash       String
  fullName           String
  /// uz | ru | tr | en
  locale             String    @default("uz")
  isActive           Boolean   @default(true)
  /// Can create and manage companies (the product operator, not a customer role)
  isPlatformAdmin    Boolean   @default(false)
  /// Set for temporary passwords; the user must choose a new one before doing anything else
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  memberships Membership[]
  sessions    Session[]
  auditLogs   AuditLog[]
}

/// Server-side login session. The browser holds a random token in an httpOnly
/// cookie; only its SHA-256 hash is stored here.
model Session {
  id              String   @id @default(uuid()) @db.Uuid
  tokenHash       String   @unique
  userId          String   @db.Uuid
  /// Company the user is currently working in (one of their memberships)
  activeCompanyId String?  @db.Uuid
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  expiresAt       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Who changed what, when. Never updated or deleted by the app.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// null for platform-level actions (e.g. creating a company)
  companyId   String?  @db.Uuid
  /// null for actions not done by a logged-in user (e.g. CLI bootstrap)
  actorUserId String?  @db.Uuid
  /// e.g. "auth.login", "member.create", "company.update"
  action      String
  entityType  String?
  entityId    String?
  /// Changed fields (before/after) or other details. Never contains passwords.
  data        Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: NoAction)
  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: NoAction)

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  TIMEKEEPER
  FOREMAN
}

model Membership {
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  role      Role
  /// Limits TIMEKEEPER/FOREMAN to one site; null = all sites
  siteId    String?  @db.Uuid
  /// Deactivated members lose access to this company; their history stays
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  /// null = pending invitation. A company that adds a person who already has an account
  /// (from another company) only invites them; they get access once they accept.
  /// Accounts the company creates itself, and owners set up by the platform, are
  /// accepted at creation.
  acceptedAt   DateTime?
  declinedAt   DateTime?
  /// What the inviting company typed. Until the person accepts, the company sees only
  /// these, never the account's own name or contacts (which may come from another company).
  invitedName  String?
  invitedEmail String?
  invitedPhone String?

  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction)
  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  site    Site?   @relation(fields: [siteId], references: [id], onDelete: NoAction)

  @@id([userId, companyId])
}

// ---------- Organisation ----------

model Site {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  name      String
  code      String?
  address   String?
  isActive  Boolean @default(true)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: NoAction)
  teams       Team[]
  assignments Assignment[]
  memberships Membership[]
  ruleSets    PayrollRuleSet[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Team {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @db.Uuid
  siteId      String  @db.Uuid
  name        String
  /// e.g. ELECTRICAL, MECHANICAL, ADMIN
  department  String?
  foremanName String?
  isActive    Boolean @default(true)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: NoAction)
  site        Site         @relation(fields: [siteId], references: [id], onDelete: NoAction)
  assignments Assignment[]

  @@unique([siteId, name])
  @@index([companyId])
}

// ---------- People ----------

enum EmploymentType {
  DIRECT
  INDIRECT
}

model Worker {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  /// Uzbek personal ID (14 digits); null for some expats
  pinfl          String?
  lastName       String
  firstName      String
  patronymic     String?
  birthDate      DateTime?      @db.Date
  nationality    String?
  passportSeries String?
  passportNumber String?
  phone          String?
  position       String?
  employmentType EmploymentType @default(DIRECT)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: NoAction)
  assignments Assignment[]

  @@unique([companyId, pinfl])
  @@index([companyId, lastName])
}

enum Shift {
  DAY
  NIGHT
}

/// A worker's employment on a site for a span of time, with its salary.
model Assignment {
  id            String    @id @default(uuid()) @db.Uuid
  workerId      String    @db.Uuid
  siteId        String    @db.Uuid
  teamId        String?   @db.Uuid
  hiredOn       DateTime  @db.Date
  leftOn        DateTime? @db.Date
  monthlySalary Decimal   @db.Decimal(14, 2)
  shift         Shift     @default(DAY)

  worker      Worker           @relation(fields: [workerId], references: [id], onDelete: NoAction)
  site        Site             @relation(fields: [siteId], references: [id], onDelete: NoAction)
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: NoAction)
  entries     TimesheetEntry[]
  adjustments Adjustment[]

  @@index([siteId, hiredOn])
  @@index([workerId])
}

// ---------- Calendar & rules ----------

model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  date      DateTime @db.Date
  name      String

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)

  @@unique([companyId, date])
}

/// Pay policy. A site-level rule set overrides the company default (siteId = null).
/// Policy fields are still being defined; `options` holds the not-yet-modelled ones.
model PayrollRuleSet {
  id                 String  @id @default(uuid()) @db.Uuid
  companyId          String  @db.Uuid
  siteId             String? @db.Uuid
  name               String
  standardDayHours   Decimal @default(9) @db.Decimal(4, 2)
  overtimeMultiplier Decimal @default(1) @db.Decimal(4, 2)
  restDayMultiplier  Decimal @default(1) @db.Decimal(4, 2)
  /// ISO weekdays that are rest days (7 = Sunday)
  restWeekdays       Int[]   @default([7])
  options            Json    @default("{}")

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  site    Site?   @relation(fields: [siteId], references: [id], onDelete: NoAction)

  /// One rule set per site. PostgreSQL treats NULLs as distinct, so "one company default
  /// (siteId = null)" is a partial unique index added by hand in its migration.
  @@unique([companyId, siteId])
}

// ---------- Timesheets & payroll ----------

enum PeriodStatus {
  OPEN
  LOCKED
}

model PayrollPeriod {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid
  year      Int
  month     Int
  status    PeriodStatus @default(OPEN)
  lockedAt  DateTime?

  company     Company          @relation(fields: [companyId], references: [id], onDelete: NoAction)
  entries     TimesheetEntry[]
  adjustments Adjustment[]

  @@unique([companyId, year, month])
}

/// Mirrors DayStatus in @puantaj/payroll.
enum DayStatus {
  WORKED
  ABSENT
  LEAVE
  SICK
  TRAVEL
  OFF
  NOT_EMPLOYED
}

model TimesheetEntry {
  id           String    @id @default(uuid()) @db.Uuid
  periodId     String    @db.Uuid
  assignmentId String    @db.Uuid
  date         DateTime  @db.Date
  status       DayStatus
  hours        Decimal   @default(0) @db.Decimal(4, 2)
  note         String?
  updatedAt    DateTime  @updatedAt

  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: NoAction)
  assignment Assignment    @relation(fields: [assignmentId], references: [id], onDelete: NoAction)

  @@unique([assignmentId, date])
  @@index([periodId])
}

enum AdjustmentType {
  TRAVEL
  BONUS
  ADVANCE
  DEDUCTION
}

/// Money added to or taken from a worker's pay for one period.
model Adjustment {
  id           String         @id @default(uuid()) @db.Uuid
  periodId     String         @db.Uuid
  assignmentId String         @db.Uuid
  type         AdjustmentType
  amount       Decimal        @db.Decimal(14, 2)
  note         String?
  createdAt    DateTime       @default(now())

  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: NoAction)
  assignment Assignment    @relation(fields: [assignmentId], references: [id], onDelete: NoAction)

  @@index([periodId, assignmentId])
}
